# External port - change this for second instance (e.g. 3001)
EXTERNAL_PORT=3000

# Container name - must be unique per instance
CONTAINER_NAME=fwc-vog-timing-team1

# Display name shown in the header
INSTANCE_NAME=FWC VoG Timing System - Team 1

# Accent colour for this instance (helps visually distinguish instances)
# Team 1: DAZN Yellow #F8FF00 | Team 2: try #00D4FF
INSTANCE_COLOR=#F8FF00

GITHUB_OWNER=yourgithubusername